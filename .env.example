# Copy this file to .env.local (same folder) and fill in the values.
# Rules: NO spaces around the = sign, NO quotes around values.
# After editing .env.local, STOP and restart "npm run dev".

# --- Gemini (server only) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name. Google renames models often. After you start the app, open http://localhost:3000/check
# and press "Test Gemini now" to see which model names your key can use.
GEMINI_MODEL=gemini-3.7-flash
# Optional: a second model to try if the first one is missing or overloaded. Leave empty if unsure.
GEMINI_FALLBACK_MODEL=
# Thinking effort: minimal | low | medium | high | off  (lower = faster). Leave as "low" if unsure.
GEMINI_THINKING=low

# --- Supabase: accounts and saved modules ---
# SUPABASE_URL must look EXACTLY like https://abcdefgh.supabase.co  (no /rest/v1, no slash at the end)
SUPABASE_URL=
# The PUBLISHABLE key (starts with sb_publishable_, or the old "anon" key). It is designed to be public:
# the browser uses it to sign people in. If both SUPABASE_URL and this key are set, login is required.
SUPABASE_PUBLISHABLE_KEY=
# The SECRET key (starts with sb_secret_). SERVER ONLY. Never paste it into the line above.
# Used only for the "report a bad question" button and the Setup check.
SUPABASE_SECRET_KEY=

# --- Shared access code (only used when accounts are OFF, i.e. the two Supabase lines above are empty) ---
# If you fill this in, people must type this code once before they can generate anything.
ACCESS_CODE=

# Do NOT add GEMINI_MOCK, GEMINI_BASE_URL, SUPABASE_ALLOW_LOCAL or NEXT_DIST_DIR. They exist only for the automated tests.
